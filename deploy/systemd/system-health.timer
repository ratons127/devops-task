[Unit]
Description=Run system-health.service every 5 minutes

[Timer]
OnBootSec=2min
OnCalendar=*:0/5
# Small jitter so a fleet of servers does not run the check at the same second.
RandomizedDelaySec=20
AccuracySec=10s
# Run a missed check after the machine was down/asleep.
Persistent=true

[Install]
WantedBy=timers.target
